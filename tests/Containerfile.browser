# Harnais des tests navigateur.
#
# L'image officielle Playwright fournit les navigateurs (via
# PLAYWRIGHT_BROWSERS_PATH) mais pas le paquet npm qui pilote. On l'installe
# here once and for all: without it, every run would pay for an "npm install"
# and depend on the network.
#
# The package version must match the browsers shipped in the base image, hence
# the two linked arguments.

ARG PLAYWRIGHT_TAG=v1.50.0-noble
FROM mcr.microsoft.com/playwright:${PLAYWRIGHT_TAG}

ARG PLAYWRIGHT_VERSION=1.50.0

# ES modules ignore NODE_PATH: resolution walks up the tree looking for a
# node_modules. The test script is therefore copied into this directory at run
# time, next to the dependencies.
WORKDIR /opt/harness
RUN npm init -y >/dev/null 2>&1 \
    && npm install --no-audit --no-fund --loglevel=error "playwright@${PLAYWRIGHT_VERSION}"
