# StashBin — Apache + mod_php.
# The PHP version is a build argument; the code is mounted at startup (never
# copied into the image), which allows editing without rebuilding.
#
#   podman build -f containers/Containerfile.apache \
#       --build-arg PHP_TAG=8.5-apache -t stashbin:8.5-apache containers/
#
# In practice, go through containers/stashbin.sh instead.

ARG PHP_TAG=8.4-apache
FROM docker.io/library/php:${PHP_TAG}

# pdo_sqlite is built in; pdo_mysql is not, and it is what a MariaDB instance
# is reached through.
RUN docker-php-ext-install -j"$(nproc)" pdo_mysql > /dev/null

# Web root on public/: the rest of the repository (src/, bin/, config.php) is
# never exposed.
RUN sed -i 's#/var/www/html#/var/www/stashbin/public#g' \
        /etc/apache2/sites-available/000-default.conf

# AllowOverride None : Apache ne cherche aucun .htaccess. Sans cela, un montage
# en lecture seule peut lui faire renvoyer « unable to read htaccess file,
# denying access to be safe » — un 403 sur toutes les pages.
RUN printf '%s\n' \
        '<Directory /var/www/stashbin/public>' \
        '    AllowOverride None' \
        '    Require all granted' \
        '    DirectoryIndex index.php' \
        '</Directory>' \
        > /etc/apache2/conf-available/stashbin.conf \
    && a2enconf stashbin

# The database lives outside the code, in a volume writable by PHP.
RUN mkdir -p /var/lib/stashbin && chown www-data:www-data /var/lib/stashbin
ENV STASHBIN_DB=/var/lib/stashbin/stashbin.sqlite
VOLUME /var/lib/stashbin

COPY apache-entrypoint.sh /usr/local/bin/stashbin-entrypoint
RUN chmod +x /usr/local/bin/stashbin-entrypoint

EXPOSE 80
CMD ["/usr/local/bin/stashbin-entrypoint"]
