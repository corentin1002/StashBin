# StashBin — nginx + PHP-FPM dans un seul conteneur.
# Deux processus au lieu d'un, mais une seule commande pour lancer la pile :
# for a test bench, that beats a two-container pod.
#
#   podman build -f containers/Containerfile.nginx \
#       --build-arg PHP_TAG=8.5-fpm -t stashbin:8.5-nginx containers/
#
# In practice, go through containers/stashbin.sh instead.

ARG PHP_TAG=8.4-fpm
FROM docker.io/library/php:${PHP_TAG}

# pdo_sqlite is built in; pdo_mysql is not, and it is what a MariaDB instance
# is reached through.
RUN docker-php-ext-install -j"$(nproc)" pdo_mysql > /dev/null

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/* \
    # Debian's default site also listens on port 80.
    && rm -f /etc/nginx/sites-enabled/default

COPY nginx.conf /etc/nginx/conf.d/stashbin.conf
COPY nginx-entrypoint.sh /usr/local/bin/stashbin-entrypoint
RUN chmod +x /usr/local/bin/stashbin-entrypoint

RUN mkdir -p /var/lib/stashbin && chown www-data:www-data /var/lib/stashbin
ENV STASHBIN_DB=/var/lib/stashbin/stashbin.sqlite
VOLUME /var/lib/stashbin

EXPOSE 80
CMD ["/usr/local/bin/stashbin-entrypoint"]
